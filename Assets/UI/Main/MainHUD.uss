/* 루트 */
.hud-root {
    width: 100%;
    height: 100%;
    flex-grow: 1;
}

/* ── 상단 왼쪽 ── */
.top-left {
    position: absolute;
    top: 30px;
    left: 30px;
}

/* 타이머 박스 */
.timer-box {
    font-size: 70px;
    color: rgb(255, 255, 255);
    background-color: rgba(20, 20, 20, 0.55);
    border-radius: 40px;
    border-width: 3px;
    border-color: rgb(0, 0, 0);
    padding: 6px 50px;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

/* 돈 박스 */
.money-box {
    flex-direction: row;
    align-items: center;
    background-color: rgba(20, 20, 20, 0.55);
    border-radius: 40px;
    border-width: 3px;
    border-color: rgb(0, 0, 0);
    padding: 6px 50px 6px 24px;
}

/* 돈 아이콘 (임시 색상 박스) */
.money-icon {
    width: 80px;
    height: 55px;
    background-color: rgb(90, 160, 90);
    border-radius: 6px;
    margin-right: 18px;
}

.money-text {
    font-size: 60px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-left;
}

/* ── 업무 리스트 ── */
.task-panel {
    position: absolute;
    top: 30px;
    right: 30px;
    width: 420px;
    height: 110px;
    background-color: rgba(20, 20, 20, 0.8);
    border-radius: 30px;
    border-width: 3px;
    border-color: rgb(0, 0, 0);
    overflow: hidden;
    align-items: center;
}

.task-header {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    margin-top: 20px;
    margin-bottom: 10px;
    width: 100%;
}

.task-header-text {
    font-size: 50px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

/* 화살표 */
.task-arrow {
    font-size: 32px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin-left: 16px;
    rotate: 0deg;
}

.task-arrow.open {
    rotate: 180deg;
}

.task-content {
    width: 100%;
    display: none;
}

.task-content.open {
    display: flex;
}

/* 스크롤뷰 내부 정렬 */
.task-content .unity-scroll-view__content-container {
    align-items: center;
}

/* 업무 항목 */
.task-item {
    font-size: 50px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin-top: 20px;
    -unity-font-style: bold;
}

.task-sub {
    font-size: 38px;
    color: rgb(210, 210, 210);
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

/* ── 대화창 ── */
.dialogue-panel {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 320px;
    background-color: rgb(245, 245, 245);
    border-top-width: 4px;
    border-top-color: rgb(0, 0, 0);
    display: none;
}

.dialogue-panel.visible {
    display: flex;
}

.dialogue-name {
    font-size: 56px;
    color: rgb(255, 255, 255);
    background-color: rgb(80, 80, 80);
    padding: 10px 0 10px 60px;
    width: 100%;
}

.dialogue-body {
    padding: 40px 0 0 60px;
}

.dialogue-text {
    font-size: 54px;
    color: rgb(0, 0, 0);
    white-space: normal;
}