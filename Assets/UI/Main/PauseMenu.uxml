<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Main/PauseMenu.uss?fileID=7433441132597879392&amp;guid=bcd7d6c847836442094122f37a6902d3&amp;type=3#PauseMenu"/>
    <ui:VisualElement name="pause-root" class="pause-root">
        <ui:VisualElement name="pause-menu" class="pause-menu">
            <ui:Label text="일시정지" class="pause-title"/>
            <ui:Button name="btn-resume" text="계속하기" class="pause-btn resume"/>
            <ui:Button name="btn-settings" text="설정" class="pause-btn settings"/>
            <ui:Button name="btn-tomenu" text="메뉴로 나가기" class="pause-btn tomenu"/>
        </ui:VisualElement>
        <ui:VisualElement name="overlay-settings" class="overlay">
            <ui:VisualElement class="settings-panel">
                <ui:Label text="설정" class="settings-title"/>
                <ui:Label text="소리" class="section-title"/>
                <ui:VisualElement class="slider-row">
                    <ui:Label text="Master" class="slider-label"/>
                    <ui:Slider name="slider-master" low-value="0" high-value="1" value="1" class="slider-field"/>
                    <ui:Label name="value-master" text="100" class="slider-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="slider-row">
                    <ui:Label text="BGM" class="slider-label"/>
                    <ui:Slider name="slider-bgm" low-value="0" high-value="1" value="1" class="slider-field"/>
                    <ui:Label name="value-bgm" text="100" class="slider-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="slider-row">
                    <ui:Label text="SFX" class="slider-label"/>
                    <ui:Slider name="slider-sfx" low-value="0" high-value="1" value="1" class="slider-field"/>
                    <ui:Label name="value-sfx" text="100" class="slider-value"/>
                </ui:VisualElement>
                <ui:Label text="화면" class="section-title"/>
                <ui:VisualElement class="dropdown-row">
                    <ui:Label text="FPS" class="dropdown-label"/>
                    <ui:DropdownField name="dropdown-fps" index="1" class="dropdown-field"/>
                </ui:VisualElement>
                <ui:VisualElement class="dropdown-row">
                    <ui:Label text="Shadow" class="dropdown-label"/>
                    <ui:DropdownField name="dropdown-shadow" index="2" class="dropdown-field"/>
                </ui:VisualElement>
                <ui:Button name="btn-close-settings" text="X" class="close-btn"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="overlay-quit" class="overlay">
            <ui:VisualElement class="confirm-panel">
                <ui:Label text="메뉴로 나가시겠습니까?" class="confirm-text"/>
                <ui:VisualElement class="confirm-row">
                    <ui:Button name="btn-confirm-yes" text="네" class="confirm-btn yes"/>
                    <ui:Button name="btn-confirm-no" text="아니요" class="confirm-btn no"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
